DOCU_KIOSK_TOKEN_SECRET=change-me-use-a-long-random-string

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-use-a-strong-password
BROKER_HOST=broker.yourdomain.local

# CORS — comma-separated list of allowed origins (e.g. broker.example.com, chrome-extension://abc123).
# Bare hostnames get https:// prepended; full origins are matched exactly.
# chrome-extension:// matches any extension ID as a prefix — pin to an exact
# chrome-extension://<id> for tighter control.  Other scheme-only entries are ignored.
# When unset, defaults to chrome-extension:// + BROKER_HOST.
CORS_ORIGINS=

# Glitchtip
GLITCHTIP_HOST=errors.yourdomain.local
GLITCHTIP_SECRET_KEY=change-me-run-openssl-rand-hex-32
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=noreply@example.com

# Sentry DSN — set after creating a project in Glitchtip
SENTRY_DSN=
