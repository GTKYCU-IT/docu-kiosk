DOCU_KIOSK_TOKEN_SECRET=change-me-use-a-long-random-string
DOCU_KIOSK_REGISTRATION_KEY=change-me
BROKER_HOST=broker.yourdomain.local

# CORS — comma-separated list of allowed origins.
# Full origins are matched exactly (e.g. https://broker.example.com).
# Entries ending with :// (e.g. chrome-extension://) match as a prefix.
# When unset, defaults to chrome-extension:// + BROKER_HOST.
CORS_ORIGINS=

# Glitchtip
GLITCHTIP_HOST=errors.yourdomain.local
GLITCHTIP_SECRET_KEY=change-me-run-openssl-rand-hex-32
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=noreply@example.com

# Sentry DSN — set after creating a project in Glitchtip
SENTRY_DSN=
