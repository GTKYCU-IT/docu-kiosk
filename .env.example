# Broker secrets — REQUIRED
# JWT signing key for admin auth. Must be a random string of at least 32
# characters (e.g. `openssl rand -hex 32`). The broker refuses to start
# without it.
DOCU_KIOSK_TOKEN_SECRET=change-me-use-a-long-random-string

# Admin bootstrap — only read on first boot (when the users table is empty).
# Set these once, or omit them after the admin user exists.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-use-a-strong-password

# Port the broker listens on (default 8080).
PORT=8080

# Token lifetimes — Go durations (e.g. 15s, 5m, 720h). The JWT TTL is how
# long access tokens stay valid (default 15s); the refresh TTL is how long a
# refresh token may be rotated (default 60 days). Invalid or non-positive
# values abort startup.
DOCU_KIOSK_JWT_TTL=15s
DOCU_KIOSK_REFRESH_TTL=720h

# Log level: DEBUG, INFO, WARN, or ERROR (default INFO). Invalid values
# abort startup.
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed CROSS-origin origins (e.g. chrome-extension://abc123, https://admin.example.com).
# Bare hostnames get https:// prepended; full origins are matched exactly.
# Same-origin requests (the kiosk SPA served by the broker) are always allowed.
# Invalid entries abort startup.
CORS_ORIGINS=

# Trusted reverse proxies — comma-separated IPs or CIDRs (e.g. 172.16.0.0/16).
# X-Forwarded-For is only honored when the direct peer matches, so clients
# cannot spoof their kiosk IP. REQUIRED when running behind Caddy; leave empty
# when clients connect directly.
TRUSTED_PROXIES=
